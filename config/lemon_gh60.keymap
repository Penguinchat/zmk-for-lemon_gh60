#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        LAYER0 {
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8        &kp N9  &kp N0     &kp MINUS  &kp EQUAL  &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E   &kp R   &kp T      &kp Y   &kp U   &kp I         &kp O   &kp P      &kp LBKT   &kp RBKT   &kp BSLH
&kp CAPS   &kp A     &kp S     &kp D   &kp F   &kp G      &kp H   &kp J   &kp K         &kp L   &kp SEMI   &kp APOS              &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C   &kp V   &kp B      &kp N   &kp M   &kp QUESTION          &kp RSHFT  &kp UP     &kp COMMA  &kp PERIOD
&kp LCTRL  &kp LALT  &kp LGUI                  &kp SPACE                                &mo 1   &kp LEFT   &kp DOWN   &kp RIGHT
            >;

            display-name = "LAYER 0";
        };

        LAYER1 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans      &trans  &trans      &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans      &trans  &trans      &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans      &trans              &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans          &trans      &trans  &trans      &trans
&trans      &trans        &trans                                    &mo 2                                 &trans  &bt BT_PRV  &trans  &bt BT_NXT
            >;

            display-name = "LAYER 1";
        };

        LAYER2 {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans
&trans       &trans  &trans                  &trans                          &trans  &trans  &trans  &trans
            >;

            display-name = "LAYER 2";
        };

        extra1 {
            status = "reserved";
            display-name = "LAYER 3";
        };

        extra2 {
            status = "reserved";
            display-name = "LAYER 4";
        };

        extra3 {
            status = "reserved";
            display-name = "LAYER 5";
        };

        extra4 {
            status = "reserved";
            display-name = "LAYER 6";
        };
    };
};
